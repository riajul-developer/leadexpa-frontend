# Where the browser reaches the Go API (cookies are set for this origin's domain via COOKIE_DOMAIN).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Our own hosts (comma-separated, e.g. app.leadexpa.app). Any other host is an agency's custom portal domain:
# its root opens that agency's portal and the API is called same-origin. Empty: custom domains are off.
NEXT_PUBLIC_APP_HOSTS=
# Server-side fetches (print route, public report SSR). Often an internal hostname in production.
API_INTERNAL_URL=http://localhost:8080
# "enabled" runs the whole app on MSW mock data (clickable prototype, no backend needed).
# The control plane's public status API, for /status (G7j). Unset: the status page reads NEXT_PUBLIC_API_URL (mocks).
NEXT_PUBLIC_STATUS_API_URL=
NEXT_PUBLIC_API_MOCKING=
# Optional: product analytics (consent-gated) and error reporting.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
# Sentry (errors only; no replay). Server falls back to NEXT_PUBLIC_SENTRY_DSN when SENTRY_DSN is unset.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_DSN=
# Release builds only: uploads source maps, then deletes them from .next.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
