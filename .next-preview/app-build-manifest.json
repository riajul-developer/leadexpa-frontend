{
  "pages": {
    "/global-error": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/global-error.css",
      "static/chunks/app/global-error.js"
    ],
    "/[locale]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/layout.css",
      "static/chunks/app/[locale]/layout.js"
    ],
    "/[locale]/(marketing)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/(marketing)/layout.css",
      "static/chunks/app/[locale]/(marketing)/layout.js"
    ],
    "/[locale]/(marketing)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/(marketing)/page.js"
    ],
    "/manifest.webmanifest/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/manifest.webmanifest/route.js"
    ],
    "/[locale]/(marketing)/features/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/(marketing)/features/page.js"
    ]
  }
}