{
  "name": "recov-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/pseudo-locale.mjs && cross-env NEXT_PUBLIC_API_MOCKING=enabled NEXT_PUBLIC_PSEUDO_LOCALE=1 next dev",
    "build": "next build",
    "start": "next start",
    "api:gen": "node scripts/gen-api.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/rtl-classes.mjs && node scripts/check-hardcodes.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/check-messages.mjs",
    "size": "node scripts/check-budgets.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:mock": "node scripts/pseudo-locale.mjs && cross-env NEXT_PUBLIC_API_MOCKING=enabled NEXT_PUBLIC_PSEUDO_LOCALE=1 next build",
    "i18n:pseudo": "node scripts/pseudo-locale.mjs",
    "rtl:check": "node scripts/rtl-classes.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@sentry/nextjs": "11.6.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "^1.438.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@faker-js/faker": "^10.6.0",
    "@next/bundle-analyzer": "15.5.27",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "size-limit": "^14.2.0",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "sideEffects": [
    "*.css",
    "./src/mocks/*",
    "./public/**"
  ]
}
